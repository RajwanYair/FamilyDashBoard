/*
 * FamilyDashBoard — HTTP response headers (Cloudflare Pages / Netlify / Vercel)
 *
 * GitHub Pages does NOT support custom headers; these headers take effect only
 * when deployed to a platform that reads _headers (e.g., Cloudflare Pages).
 *
 * V12-SEC changes:
 *   - COEP upgraded from `require-corp` → `credentialless` (ADR-018 note)
 *   - Permissions-Policy expanded to cover all sensor/communication APIs
 *   - CDN cache headers: immutable on fingerprinted assets, SWR on shell
 *   - Strict-Transport-Security added (30-day HSTS with preload readiness)
 *
 * See ADR-018 for the full CSP / COOP / COEP rationale.
 * See docs/security.md for the security model.
 */

# ── All routes — security baseline ───────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=2592000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-site
  Origin-Agent-Cluster: ?1
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), autoplay=(self), battery=(), bluetooth=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(self), compute-pressure=(self), display-capture=(), document-domain=(), encrypted-media=(self), fullscreen=(self), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), identity-credentials-get=(), interest-cohort=(), keyboard-map=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), private-state-token-issuance=(), private-state-token-redemption=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), speaker-selection=(), storage-access=(), sync-xhr=(), unload=(), usb=(), web-share=(), window-management=(), xr-spatial-tracking=()
  Content-Security-Policy: trusted-types dashboard; require-trusted-types-for 'script'

# ── Shell HTML — short cache, stale-while-revalidate ─────────────────────────
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ── Fingerprinted JS/CSS assets — immutable, 1 year ──────────────────────────
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# ── Service Worker — never cache ─────────────────────────────────────────────
/sw.js
  Cache-Control: no-store

# ── Web App Manifest — short cache ───────────────────────────────────────────
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# ── Icon — medium cache ───────────────────────────────────────────────────────
/icon.svg
  Cache-Control: public, max-age=604800

