{
    "name": "familydashboard",
    "version": "6.0.0-alpha.1",
    "description": "Family TV Dashboard — Hebrew RTL, TypeScript, Vite, Cloudflare Workers",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc -b --noEmit",
        "check": "npm run typecheck && npm run lint && npm run test"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "vite": "^6.3.2",
        "typescript": "^5.8.3",
        "vitest": "^3.1.2",
        "happy-dom": "^17.4.4",
        "@vitest/coverage-v8": "^3.1.2",
        "eslint": "^9.25.1",
        "@eslint/js": "^9.25.1",
        "typescript-eslint": "^8.31.0"
    }
}
