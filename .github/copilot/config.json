{
    "version": "2.0.0",
    "project": "FamilyDashBoard",
    "appVersion": "15.5.0",
    "copilot": {
        "enabled": true,
        "features": {
            "custom_agents": true,
            "inline_suggestions": true,
            "documentation_generation": true,
            "code_review": true,
            "next_edit_suggestions": true,
            "agent_handoffs": true,
            "model_selection_in_prompts": true,
            "memory_tool_three_tier": true,
            "deferred_tools_via_tool_search": true,
            "mcp_streamable_http": true,
            "mcp_resources": true,
            "mcp_prompts": true,
            "mcp_elicitation": true,
            "mcp_apps_inline_ui": true,
            "mcp_oauth2_auth": true,
            "vision_tools": true,
            "runSubagent": true,
            "manage_todo_list": true,
            "chat_customizations_editor": true,
            "chat_diagnostics": true,
            "vscode_rename_symbol": true,
            "vscode_list_code_usages": true,
            "vscode_ask_questions": true,
            "multi_replace_string_in_file": true,
            "send_to_terminal": true,
            "kill_terminal": true,
            "post_edit_hooks": true,
            "fetch_webpage": true
        }
    },
    "extensions": {
        "eslint": {
            "id": "dbaeumer.vscode-eslint",
            "token_hint": "Prefer get_errors over terminal lint for single-file checks"
        },
        "prettier": {
            "id": "esbenp.prettier-vscode",
            "token_hint": "Format-on-save — no formatting fixups needed"
        },
        "vitest": {
            "id": "vitest.explorer",
            "token_hint": "Use runTests or run_task over raw npx vitest"
        },
        "playwright": {
            "id": "ms-playwright.playwright",
            "token_hint": "Use view_image on test-results/ for VR failure diagnosis"
        },
        "gitlens": {
            "id": "eamodio.gitlens",
            "token_hint": "Git history via GitKraken MCP"
        },
        "github-actions": {
            "id": "GitHub.vscode-github-actions"
        },
        "spell-checker": {
            "id": "streetsidesoftware.code-spell-checker",
            "token_hint": "Spell-check via get_errors (HE+EN)"
        },
        "todo-tree": {
            "id": "Gruntfuggly.todo-tree"
        },
        "stylelint": {
            "id": "stylelint.vscode-stylelint",
            "token_hint": "CSS diagnostics via get_errors"
        },
        "markdownlint": {
            "id": "DavidAnson.vscode-markdownlint",
            "token_hint": "Markdown diagnostics via get_errors"
        },
        "edge-devtools": {
            "id": "ms-edgetools.vscode-edge-devtools"
        },
        "powershell": {
            "id": "ms-vscode.powershell",
            "token_hint": "All terminal commands must be PowerShell"
        },
        "editorconfig": {
            "id": "EditorConfig.EditorConfig",
            "token_hint": "Format handled on save — skip whitespace fixups"
        },
        "html-css": {
            "id": "ecmel.vscode-html-css"
        },
        "coverage-gutters": {
            "id": "ryanluker.vscode-coverage-gutters",
            "token_hint": "User sees coverage inline — no need to parse lcov.info"
        },
        "error-lens": {
            "id": "usernamehw.errorlens",
            "token_hint": "User already sees inline errors — get_errors confirms"
        },
        "console-ninja": {
            "id": "wallabyjs.console-ninja",
            "token_hint": "User sees diagLog inline — no temp logging needed"
        },
        "baseline-lens": {
            "id": "kwesinavilot.baseline-lens"
        },
        "version-lens": {
            "id": "pflannery.vscode-versionlens",
            "token_hint": "User sees outdated deps inline — skip npm outdated"
        },
        "bookmarks": {
            "id": "alefragnani.bookmarks"
        },
        "mermaid-chart": {
            "id": "mermaidchart.vscode-mermaid-chart"
        },
        "caniuse": {
            "id": "akamud.vscode-caniuse"
        },
        "svg-preview": {
            "id": "jock.svg"
        },
        "browserslist": {
            "id": "webben.browserslist"
        }
    },
    "tokenOptimization": {
        "strategy": "context-economy",
        "rules": [
            "Instructions use applyTo globs — only loaded when relevant",
            "get_errors aggregates ESLint + Stylelint + markdownlint + spell-check",
            "run_task / runTests over terminal for predefined workspace commands",
            "multi_replace_string_in_file for batch edits (2+ independent changes)",
            "search_subagent / runSubagent for multi-file exploration — avoids main-thread clutter",
            "tool_search once per MCP tool family — broad queries discover deferred tools",
            "Deferred tools stay unloaded until needed (MCP + VS Code deferred)",
            "Error Lens / Coverage Gutters / Console Ninja / Version Lens show data inline — confirm, don't re-explain",
            "Hooks: PreToolUse guards duplicates + context; PostToolUse auto-reminds conventions",
            "vscode_listCodeUsages before refactoring — avoids missed references",
            "vscode_renameSymbol for semantics-aware renames across workspace",
            "Cloudflare MCP for worker management — avoid manual wrangler CLI",
            "Read instruction files only when applyTo matches — skip for unrelated edits"
        ]
    }
}
