{
    "version": "1.2.0",
    "project": "FamilyDashBoard",
    "appVersion": "13.29.0",
    "copilot": {
        "enabled": true,
        "features": {
            "custom_agents": true,
            "inline_suggestions": true,
            "documentation_generation": true,
            "code_review": true,
            "next_edit_suggestions": true
        }
    },
    "modes": {
        "ui-mode": {
            "enabled": true,
            "aliases": ["design", "css", "layout", "theme"],
            "priority": "high",
            "context_files": [
                "src/styles/tokens.css",
                "src/styles/themes.css",
                "src/styles/components.css"
            ],
            "description": "UI/UX: CSS custom properties, glassmorphism, RTL layout, 6 themes"
        },
        "api-mode": {
            "enabled": true,
            "aliases": ["fetch", "data", "weather", "stocks"],
            "priority": "high",
            "context_files": ["src/core/fetch.ts", "src/core/cache.ts", "src/core/constants.ts"],
            "description": "API integration: fetch, caching, proxy fallback, diagnostics"
        },
        "fix-mode": {
            "enabled": true,
            "aliases": ["debug", "troubleshoot", "error"],
            "priority": "high",
            "context_files": ["src/core/diag.ts", "src/core/fetch.ts"],
            "description": "Debug fetch failures, dead code, JS syntax errors"
        },
        "docs-mode": {
            "enabled": true,
            "aliases": ["documentation", "readme"],
            "priority": "medium",
            "context_files": ["README.md", "CHANGELOG.md"],
            "description": "Documentation, README, CHANGELOG, SVG assets"
        },
        "security-mode": {
            "enabled": true,
            "aliases": ["security", "audit", "xss"],
            "priority": "critical",
            "context_files": ["src/main.ts", ".github/SECURITY.md"],
            "description": "Security: XSS prevention, CSP, API input sanitization"
        },
        "pre-release-mode": {
            "enabled": true,
            "aliases": ["release", "cleanup", "pre-release", "production", "tag"],
            "priority": "critical",
            "context_files": [
                ".github/instructions/pre-release.instructions.md",
                ".github/skills/release/SKILL.md",
                "CHANGELOG.md",
                "package.json"
            ],
            "description": "Pre-release cleanup: 0 errors, 0 warnings, dead-code removal, docs dedup, issue closing, git tag"
        }
    }
}
