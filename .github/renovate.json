{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", ":semanticCommits", ":separatePatchReleases"],
    "description": "FamilyDashBoard — Renovate dependency update configuration. Owns npm dependency PRs; Dependabot owns GitHub Actions. D14 schedule: security at any time, minors+patches monthly, majors manual.",
    "assignees": ["RajwanYair"],
    "labels": ["dependencies"],
    "reviewers": ["RajwanYair"],
    "schedule": ["on the first day of the month"],
    "timezone": "Asia/Jerusalem",
    "prConcurrentLimit": 5,
    "prHourlyLimit": 3,
    "automerge": false,
    "semanticCommitType": "chore",
    "semanticCommitScope": "deps",
    "commitMessagePrefix": "chore(deps):",
    "packageRules": [
        {
            "description": "Group all TypeScript updates together",
            "matchPackageNames": ["typescript", "@typescript/*", "@types/*"],
            "groupName": "TypeScript & Types",
            "automerge": false
        },
        {
            "description": "Group Vite and Vitest together (they share versioning)",
            "matchPackageNames": ["vite", "vitest", "@vitest/*", "vite-plugin-*"],
            "groupName": "Vite/Vitest toolchain",
            "automerge": false
        },
        {
            "description": "Group ESLint + plugins",
            "matchPackageNames": ["eslint", "@eslint/*", "typescript-eslint", "eslint-plugin-*"],
            "groupName": "ESLint + plugins",
            "automerge": true,
            "automergeType": "branch",
            "automergeStrategy": "squash"
        },
        {
            "description": "Worker dependencies — Hono + Valibot",
            "matchFileNames": ["worker/package.json"],
            "groupName": "Worker (Hono + Valibot)",
            "automerge": false,
            "labels": ["dependencies", "worker"]
        },
        {
            "description": "D14: Minor devDep updates — monthly cadence, low-risk auto-merge",
            "matchDepTypes": ["devDependencies"],
            "matchUpdateTypes": ["minor"],
            "matchFileNames": ["package.json"],
            "schedule": ["on the first day of the month"],
            "automerge": true,
            "automergeType": "branch",
            "automergeStrategy": "squash"
        },
        {
            "description": "QA-6: Patch devDep updates — immediate auto-merge, no schedule constraint (lower risk than minor)",
            "matchDepTypes": ["devDependencies"],
            "matchUpdateTypes": ["patch"],
            "matchFileNames": ["package.json"],
            "schedule": ["at any time"],
            "automerge": true,
            "automergeType": "branch",
            "automergeStrategy": "squash",
            "groupName": "devDeps patch updates"
        },
        {
            "description": "D14: Major bumps — always manual review, no auto-merge, no schedule cap",
            "matchUpdateTypes": ["major"],
            "automerge": false,
            "labels": ["dependencies", "major-upgrade"]
        },
        {
            "description": "Pin GitHub Actions to exact SHA (supply-chain hardening)",
            "matchManagers": ["github-actions"],
            "pinDigests": true,
            "automerge": true,
            "automergeType": "branch",
            "automergeStrategy": "squash",
            "groupName": "GitHub Actions"
        }
    ],
    "vulnerabilityAlerts": {
        "labels": ["security", "vulnerability"],
        "automerge": true,
        "automergeType": "branch",
        "automergeStrategy": "squash",
        "schedule": ["at any time"]
    },
    "ignorePaths": ["**/node_modules/**", "**/dist/**", "**/coverage/**", "tooling/**"],
    "rangeStrategy": "bump",
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["on the first day of the month"]
    }
}
