{
  // Renovate configuration for FamilyDashBoard
  // Automates dependency update PRs for dev tools in the parent MyScripts/ workspace.
  // See: https://docs.renovatebot.com/configuration-options/
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeMinor"
  ],

  // Group all tooling updates into a single "dev deps" PR to reduce noise
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies (minor/patch)",
      "automerge": false
    },
    {
      // major updates need manual review
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      // GitHub Actions: use exact sha pinning or version tags
      "matchManagers": ["github-actions"],
      "pinDigests": false,
      "groupName": "GitHub Actions"
    },
    {
      // Vite + Vitest together (usually released in sync)
      "matchPackageNames": ["vite", "vitest", "@vitest/coverage-v8"],
      "groupName": "Vite/Vitest toolchain"
    },
    {
      // TypeScript toolchain
      "matchPackageNames": ["typescript", "typescript-eslint", "@typescript-eslint/eslint-plugin", "@typescript-eslint/parser"],
      "groupName": "TypeScript toolchain"
    }
  ],

  // Where dev deps live (parent monorepo)
  "baseBranches": ["main"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,

  // Custom commit message prefix
  "commitMessagePrefix": "chore(deps):",

  // Ignore dist, coverage, generated files
  "ignorePaths": ["dist/**", "coverage/**", "node_modules/**"]
}
