{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./base-typescript.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": ["ES2022"],
        "allowImportingTsExtensions": false,
        "noEmit": false,
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "esModuleInterop": true
    }
}
