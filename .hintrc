{
  "extends": [
    "development"
  ],
  "browserslist": [
    "chrome >= 114",
    "edge >= 114",
    "firefox >= 128",
    "firefox esr",
    "safari >= 17.4",
    "opera >= 100",
    "samsung >= 23",
    "ios_saf >= 17.4",
    "not ie > 0",
    "not op_mini all"
  ],
  "hints": {
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "meta[name=theme-color]",
          "script[type=speculationrules]"
        ]
      }
    ],
    "compat-api/css": "default",
    "compat-api/js": "default",
    "no-inline-styles": "off",
    "no-broken-links": "off"
  }
}
