{
  "extends": [
    "development"
  ],
  "browserslist": [
    "chrome >= 114",
    "edge >= 114",
    "firefox >= 128",
    "firefox esr",
    "safari >= 17.4",
    "opera >= 100",
    "samsung >= 23",
    "ios_saf >= 17.4",
    "and_chr >= 114",
    "and_ff >= 128",
    "op_mob >= 80",
    "android >= 114",
    "not ie > 0",
    "not op_mini all"
  ],
  "hints": {
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "meta[name=theme-color]",
          "script[type=speculationrules]",
          "main",
          "dialog",
          "details",
          "summary",
          "dir",
          "autocomplete",
          "popover",
          "popovertarget",
          "input[type=date]",
          "input[type=time]"
        ],
        "enable": []
      }
    ],
    "compat-api/css": "off",
    "compat-api/js": "off",
    "no-inline-styles": "off",
    "no-broken-links": "off"
  }
}
