{
    "ci": {
        "collect": {
            "numberOfRuns": 1,
            "startServerCommand": "npx vite preview --port 3010",
            "startServerReadyPattern": "Local.*3010",
            "startServerReadyTimeout": 30000,
            "url": ["http://localhost:3010/"]
        },
        "assert": {
            "_comment": [
                "Sprint 124 (Roadmap #19): HTTP Early Hints shipped (Sprint 122).",
                "Sprint 147 (v13.16.0): perf warn ratcheted 0.80 -> 0.85.",
                "Sprint 161 (v13.18.0): ADR-042 step 2 — promoted warn 0.85 -> error 0.85.",
                "Sprint 217 (v13.24.0): ADR-042 step 3 — ratcheted error 0.85 -> error 0.92.",
                "Final target (step 4): error 0.97 at v14.2.",
                "accessibility: error >= 0.90 (a11y regressions block CI).",
                "best-practices: error >= 0.90 (security/best-practice regressions block CI)."
            ],
            "assertions": {
                "categories:accessibility": ["error", { "minScore": 0.90 }],
                "categories:performance": ["error", { "minScore": 0.92 }],
                "categories:best-practices": ["error", { "minScore": 0.9 }],
                "total-blocking-time": ["warn", { "maxNumericValue": 300 }],
                "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
                "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }]
            }
        },
        "upload": {
            "target": "temporary-public-storage"
        }
    }
}
