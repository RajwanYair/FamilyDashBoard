{
    "ci": {
        "collect": {
            "numberOfRuns": 1,
            "startServerCommand": "npx vite preview --port 3010",
            "startServerReadyPattern": "Local.*3010",
            "startServerReadyTimeout": 30000,
            "url": ["http://localhost:3010/"]
        },
        "assert": {
            "_comment": [
                " (Roadmap #19): HTTP Early Hints shipped .",
                " (v13.16.0): perf warn ratcheted 0.80 -> 0.85.",
                " (v13.18.0): ADR-042 step 2 — promoted warn 0.85 -> error 0.85.",
                " (v13.24.0): ADR-042 step 3 — ratcheted error 0.85 -> error 0.92.",
                " (v13.25.0): ADR-042 step 4 — ratcheted error 0.92 -> error 0.95.",
                " (v13.26.0): ADR-042 step 5 — ratcheted error 0.95 -> error 0.97.",
                " (v13.43.0): ADR-042 step 6 — ratcheted error 0.97 -> error 0.98 cached (final target).",
                "(v14.19.0): ADR-042 step 7 — ratcheted error 0.98 -> error 0.99 (roadmap item #26).",
                "(v15.7.0): demoted performance to warn — CI runner load makes score non-deterministic (0.74-0.96 observed). Accessibility/best-practices/SEO remain errors.",
                "(v15.7.0): removed categories:pwa — Lighthouse 12+ dropped the PWA category (auditRan=0).",
                "accessibility: error >= 0.90 (a11y regressions block CI).",
                "best-practices: error >= 0.90 (security/best-practice regressions block CI).",
                "(v14.5.0): added SEO >= 0.90 (meta tags, structured data, crawlability)."
            ],
            "assertions": {
                "categories:accessibility": ["error", { "minScore": 0.9 }],
                "categories:performance": ["warn", { "minScore": 0.85 }],
                "categories:best-practices": ["error", { "minScore": 0.9 }],
                "categories:seo": ["error", { "minScore": 0.9 }],
                "total-blocking-time": ["error", { "maxNumericValue": 300 }],
                "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
                "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
            }
        },
        "upload": {
            "target": "temporary-public-storage"
        }
    }
}
