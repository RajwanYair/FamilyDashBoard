{
  "id": "/FamilyDashBoard/",
  "name": "רגואן Family Dashboard",
  "short_name": "Dashboard",
  "description": "Family TV Dashboard — Hebrew RTL, 6 dark themes, live weather/news/stocks/calendar.",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "start_url": "./index.html",
  "scope": "./",
  "background_color": "#060b14",
  "theme_color": "#060b14",
  "orientation": "landscape",
  "lang": "he",
  "dir": "rtl",
  "categories": ["lifestyle", "utilities"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icon.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "maskable" },
    { "src": "./icon.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
      "name": "לוח משפחתי",
      "url": "./index.html",
      "description": "פתח לוח הבקרה המשפחתי"
    }
  ]
}
