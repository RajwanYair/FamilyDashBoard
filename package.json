{
    "name": "familydashboard",
    "version": "15.3.0",
    "description": "Family TV Dashboard — Hebrew RTL, TypeScript, Vite, Cloudflare Workers",
    "author": "Reuven Airhar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/RajwanYair/FamilyDashBoard.git"
    },
    "homepage": "https://RajwanYair.github.io/FamilyDashBoard/",
    "bugs": {
        "url": "https://github.com/RajwanYair/FamilyDashBoard/issues"
    },
    "keywords": [
        "dashboard",
        "family-dashboard",
        "family",
        "hebrew",
        "rtl",
        "israel",
        "typescript",
        "vite",
        "pwa",
        "cloudflare-workers",
        "tv-display",
        "smart-home",
        "zero-dependencies",
        "glassmorphism",
        "dark-theme",
        "real-time",
        "weather",
        "stocks",
        "news-reader",
        "github-pages",
        "service-worker",
        "offline-first",
        "css-custom-properties",
        "vitest"
    ],
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "build": "tsc -b && vite build",
        "build:local": "tsc -b && vite build --base ./",
        "postbuild": "node scripts/generate-precache.mjs",
        "preview": "vite preview",
        "test": "vitest run",
        "test:browser": "vitest --config vitest.browser.config.ts",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . --max-warnings 0 --cache --cache-strategy content",
        "lint:fix": "eslint . --fix --cache --cache-strategy content",
        "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules/**\" \"#worker/node_modules/**\" \"#test-results/**\"",
        "lint:instructions": "node scripts/lint-instructions.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -b --noEmit",
        "typecheck:sw": "tsc --project tsconfig.sw.json",
        "check": "npm run typecheck && npm run typecheck:sw && npm run lint && npm run format:check && npm run lint:md && npm run lint:instructions && npm run check:sw && npm run check:version && npm run check:worker-client && npm run check:adr && npm run check:openapi-ttl && npm run check:release-notes && npm run check:reading-level && npm run check:smart-contrast && npm run check:boundaries && npm run check:test-focus && npm run check:artifacts && npm run check:owasp && npm run check:trusted-types && npm run check:csp-wildcards && npm run check:dead-exports && npm run check:vendor && npm run check:mermaid && npm run check:containers && npm run check:cross-project && npm run check:temporal-polyfill && npm run test",
        "check:test-focus": "node scripts/check-test-focus-skip.mjs",
        "check:artifacts": "node scripts/check-build-artifacts-untracked.mjs",
        "check:boundaries": "node scripts/check-module-boundaries.mjs",
        "check:reading-level": "node scripts/check-reading-level.mjs",
        "check:smart-contrast": "node scripts/check-smart-contrast.mjs",
        "check:trusted-types": "node scripts/check-trusted-types.mjs",
        "check:owasp": "node scripts/check-owasp.mjs",
        "check:csp-wildcards": "node scripts/check-csp-wildcards.mjs",
        "check:actions-pinned": "node scripts/check-actions-pinned.mjs",
        "check:ignore-scripts": "node scripts/check-npm-ignore-scripts.mjs",
        "check:cross-project": "node scripts/check-cross-project-gate.mjs",
        "check:mermaid": "node scripts/check-mermaid.mjs",
        "check:containers": "node scripts/check-container-queries.mjs",
        "check:sigstore": "node scripts/check-sigstore.mjs",
        "check:reproducible": "node scripts/check-reproducible.mjs --dry-run",
        "check:bundle": "node scripts/check-bundle-size.mjs",
        "check:card-bundle": "node scripts/check-card-bundle-delta.mjs",
        "check:cards": "npm run check:boundaries && npm run check:bundle && npm run check:card-bundle",
        "bundle:trend": "node scripts/bundle-trend.mjs",
        "install:hooks": "node scripts/install-git-hooks.mjs",
        "mutate": "stryker run scripts/stryker.config.mjs",
        "arch:table": "node scripts/generate-arch-table.mjs",
        "adr:index": "node scripts/generate-adr-index.mjs",
        "release:report": "node scripts/release-report.mjs",
        "audit": "npm audit --audit-level=high",
        "check:sw": "node scripts/check-sw-version.mjs",
        "check:version": "node scripts/check-version-consistency.mjs",
        "check:worker-client": "node scripts/check-worker-client.mjs",
        "check:adr": "node scripts/check-adr-index.mjs",
        "check:openapi-ttl": "node scripts/check-openapi-ttl.mjs",
        "check:release-notes": "node scripts/check-release-notes.mjs",
        "check:vendor": "node scripts/check-vendor-neutrality.mjs",
        "check:vendor-gate": "node scripts/check-vendor-neutrality.mjs --gate",
        "check:temporal-polyfill": "node scripts/check-temporal-polyfill-size.mjs",
        "check:dead-exports": "node scripts/check-dead-exports.mjs --fail-on-dead",
        "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose",
        "changeset": "changeset",
        "changeset:add": "changeset add",
        "changeset:version": "changeset version",
        "changeset:publish": "changeset publish"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
        "npm": ">=10.0.0"
    }
}
