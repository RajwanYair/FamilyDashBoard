{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "pwsh.exe",
                "args": ["-NoLogo", "-NoProfile", "-Command"]
            }
        }
    },
    "tasks": [
        {
            "label": "✅ Repository Quality Gate",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; npm run check; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$tsc", "$eslint-stylish"]
        },
        {
            "label": "🔬 Vitest: Run All Tests",
            "type": "shell",
            "command": "npm exec -- vitest run",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "🔬 Vitest: Watch Mode",
            "type": "shell",
            "command": "npm exec -- vitest",
            "group": "test",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [
                {
                    "owner": "vitest",
                    "pattern": {
                        "regexp": "^\\s*FAIL\\s+(.+)$",
                        "file": 1,
                        "message": 0
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^.*RERUN.*$",
                        "endsPattern": "^.*(Tests|passed|failed).*$"
                    }
                }
            ]
        },
        {
            "label": "🔬 Vitest: Current File",
            "type": "shell",
            "command": "npm exec -- vitest run ${relativeFile}",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "📊 Vitest: Coverage Report",
            "type": "shell",
            "command": "npm exec -- vitest run --coverage",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "🔍 ESLint: Lint src + tests",
            "type": "shell",
            "command": "npm exec -- eslint src tests --max-warnings 0",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$eslint-stylish"]
        },
        {
            "label": "🔧 ESLint: Fix src + tests",
            "type": "shell",
            "command": "npm exec -- eslint src tests --fix",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$eslint-stylish"]
        },
        {
            "label": "🏷️ TypeScript: Type Check",
            "type": "shell",
            "command": "npm exec -- tsc --noEmit",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$tsc"]
        },
        {
            "label": "🏗️ Build: GitHub Pages",
            "type": "shell",
            "command": "npm run build",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$tsc"]
        },
        {
            "label": "🏗️ Build: Local file://",
            "type": "shell",
            "command": "npm run build:local",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$tsc"]
        },
        {
            "label": "📝 Markdownlint: Docs",
            "type": "shell",
            "command": "npm run lint:md",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "📦 Bundle Size Check",
            "type": "shell",
            "command": "npm run check:bundle",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "🔒 npm Audit (high+)",
            "type": "shell",
            "command": "npm run audit",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "☁️ Worker: Type Check",
            "type": "shell",
            "command": "npm run typecheck",
            "options": {
                "cwd": "${workspaceFolder}/worker"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$tsc"]
        },
        {
            "label": "🚀 Dev Server",
            "type": "shell",
            "command": "npm exec -- vite",
            "group": "build",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "🌐 Serve Local: Dev (hot-reload)",
            "type": "shell",
            "command": "npm exec -- vite --host",
            "group": "build",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "🌐 Serve Local: Preview (production build)",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; npm exec -- vite build; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npm exec -- vite preview --host",
            "group": "build",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "🎭 Playwright: E2E Tests",
            "type": "shell",
            "command": "npm exec -- playwright test",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "🎭 Playwright: Visual Regression",
            "type": "shell",
            "command": "npm exec -- playwright test tests/e2e/visual-regression.spec.ts",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "🎭 Playwright: Update Snapshots",
            "type": "shell",
            "command": "npm exec -- playwright test tests/e2e/visual-regression.spec.ts --update-snapshots",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "⏱️ Benchmark: Check Regression",
            "type": "shell",
            "command": "npm run check:benchmark",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "⏱️ Benchmark: Update Baseline",
            "type": "shell",
            "command": "npm run bench:update",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "⏱️ Benchmark: Report Only",
            "type": "shell",
            "command": "npm run bench:report",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "🚀 Production Readiness Gate",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; npm run check; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npm run test:e2e; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npm run check:bundle; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": ["$tsc", "$eslint-stylish"],
            "detail": "Full production gate: typecheck + lint + test + e2e + bundle size"
        },
        {
            "label": "🧹 Clean Generated Files",
            "type": "shell",
            "command": "Remove-Item -Recurse -Force -ErrorAction SilentlyContinue dist, coverage, test-results, playwright-report, blob-report, .playwright, .eslintcache, tsconfig.tsbuildinfo ; Write-Host '✅ Cleaned all generated files'",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "detail": "Remove all build/test/cache artifacts from workspace"
        },
        {
            "label": "📋 Release Report",
            "type": "shell",
            "command": "node scripts/release-report.mjs",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "detail": "Generate release readiness report"
        },
        {
            "label": "🔍 Dead Exports Scan",
            "type": "shell",
            "command": "node scripts/check-dead-exports.mjs --fail-on-dead",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "detail": "Find unused exports across the codebase"
        },
        {
            "label": "🛡️ Security: Full OWASP Audit",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; node scripts/check-owasp.mjs; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node scripts/check-trusted-types.mjs; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node scripts/check-csp-wildcards.mjs; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "detail": "Run all security checks: OWASP + Trusted Types + CSP"
        },
        {
            "label": "📊 Coverage to TEMP",
            "type": "shell",
            "command": "npm exec -- vitest run --coverage --coverage.reportsDirectory \"$env:TEMP/FamilyDashBoard/coverage\"",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "detail": "Run coverage with output to $TEMP (not in workspace)"
        },
        {
            "label": "🔧 Repair Shared Toolchain Resolution",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $repo = (Get-Location).Path; $shared = Join-Path $HOME 'OneDrive - Intel Corporation\\Documents\\MyScripts\\node_modules'; $local = Join-Path $repo 'node_modules'; if (-not (Test-Path $shared)) { throw \"Shared node_modules not found: $shared\" }; if (-not (Test-Path $local)) { New-Item -ItemType Junction -Path $local -Target $shared | Out-Null }; Write-Host \"Resolution junction: $local -> $shared\"; npm exec -- tsc --noEmit; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; npm exec -- vitest run tests/unit/core/freshness.test.ts --reporter=dot; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
            "isBackground": false,
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "🔬 Freshness Test Single Thread",
            "type": "shell",
            "command": "npm exec -- vitest run tests/unit/core/freshness.test.ts --pool=forks --fileParallelism=false --reporter=dot",
            "isBackground": false,
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "🔬 Freshness Test Threads",
            "type": "shell",
            "command": "npm exec -- vitest run tests/unit/core/freshness.test.ts --pool=threads --reporter=dot",
            "isBackground": false,
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
