{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Vite Dev Server (attach)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["vite", "--host"],
            "cwd": "${workspaceFolder}",
            "skipFiles": ["<node_internals>/**"],
            "resolveSourceMapLocations": ["${workspaceFolder}/src/**"],
            "presentation": {
                "group": "dev",
                "order": 1
            }
        },
        {
            "name": "🔬 Vitest: Run All Tests",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["vitest", "run", "--reporter=verbose"],
            "cwd": "${workspaceFolder}",
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "presentation": {
                "group": "test",
                "order": 1
            }
        },
        {
            "name": "🔬 Vitest: Current File",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["vitest", "run", "${relativeFile}"],
            "cwd": "${workspaceFolder}",
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "presentation": {
                "group": "test",
                "order": 2
            }
        },
        {
            "name": "☁️ Worker Dev (wrangler)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["wrangler", "dev", "--local"],
            "cwd": "${workspaceFolder}/worker",
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "presentation": {
                "group": "dev",
                "order": 2
            }
        },
        {
            "name": "🐛 Vitest: Debug (breakpoints)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "vitest",
                "run",
                "--inspect-brk",
                "--pool=forks",
                "--poolOptions.forks.singleFork=true"
            ],
            "cwd": "${workspaceFolder}",
            "port": 9229,
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "presentation": {
                "group": "test",
                "order": 3
            }
        },
        {
            "name": "🐛 Vitest: Debug Current File",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "vitest",
                "run",
                "${relativeFile}",
                "--inspect-brk",
                "--pool=forks",
                "--poolOptions.forks.singleFork=true"
            ],
            "cwd": "${workspaceFolder}",
            "port": 9229,
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "presentation": {
                "group": "test",
                "order": 4
            }
        },
        {
            "name": "🎭 Playwright: Debug E2E Tests",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["playwright", "test", "--project=chromium", "--debug"],
            "cwd": "${workspaceFolder}",
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "env": {
                "PWDEBUG": "1"
            },
            "presentation": {
                "group": "test",
                "order": 5
            }
        }
    ]
}
