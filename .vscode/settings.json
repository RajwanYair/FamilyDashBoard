{
    // ── Editor ──
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.bracketPairColorization.enabled": true,
    "editor.linkedEditing": true,
    "editor.minimap.enabled": false,
    "editor.wordWrap": "on",
    "editor.suggestSelection": "first",
    "editor.inlineSuggest.enabled": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.fixAll.stylelint": "explicit",
        "source.organizeImports": "never"
    },
    // ── TypeScript ──
    "typescript.tsdk": "../node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    // ── ESLint ──
    "eslint.validate": [
        "javascript",
        "typescript"
    ],
    "eslint.run": "onType",
    "eslint.useFlatConfig": true,
    "eslint.lintTask.enable": true,
    // ── Stylelint ──
    "stylelint.validate": [
        "css",
        "html"
    ],
    "css.validate": false,
    // ── HTMLHint ──
    "htmlhint.enable": true,

    // ── Files ──
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "*.html": "html"
    },

    // ── HTML ──
    "html.format.wrapLineLength": 120,
    "html.format.indentInnerHtml": true,
    "html.autoClosingTags": true,

    // ── Emmet ──
    "emmet.includeLanguages": {
        "html": "html"
    },

    // ── Git ──
    "git.autofetch": "all",
    "git.autofetchPeriod": 300,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,

    // ── GitHub Copilot ──
    "github.copilot.enable": {
        "*": true,
        "html": true,
        "javascript": true,
        "css": true,
        "markdown": true,
        "yaml": true,
        "json": true
    },
    "chat.agent.enabled": true,
    "chat.useCustomizationsInParentRepositories": true,
    "chat.mcp.autoStart": true,
    "chat.tools.terminal.backgroundNotifications": true,
    "chat.tools.confirmationCarousel.enabled": true,
    "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
    "jsts-chat-features.skills.enabled": true,
    "chat.instructionFilesLocations": {
        ".github/instructions": true,
        ".github/copilot-instructions.md": true
    },
    "chat.promptFilesLocations": {
        ".github/prompts": true
    },
    "chat.skillsFilesLocations": {
        ".github/skills": true
    },

    // ── Spell Check ──
    "cSpell.words": [
        "rajwan",
        "glassmorphism",
        "hebcal",
        "meteo",
        "rotter",
        "giphy",
        "INTC",
        "NVDA",
        "PLTR",
        "familydashboard"
    ],

    // ── Search ──
    "search.exclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/dist": true,
        "**/coverage": true
    },

    // ── Terminal Performance ──
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.smoothScrolling": false,
    "terminal.integrated.persistentSessionScrollback": 500,
    "terminal.integrated.scrollback": 5000,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "terminal.integrated.enableImages": false,
    "terminal.integrated.defaultProfile.windows": "PowerShell Fast",
    "terminal.integrated.profiles.windows": {
        "PowerShell Fast": {
            "source": "PowerShell",
            "args": [
                "-NoLogo"
            ],
            "icon": "terminal-powershell"
        },
        "PowerShell NoProfile": {
            "source": "PowerShell",
            "args": [
                "-NoLogo",
                "-NoProfile"
            ],
            "icon": "terminal-powershell"
        }
    },

    // ── Testing — use terminal only, not VS Code test explorer ──
    "nodejs-testing.enable": false,
    "vitest.enable": false,
    "testing.automaticallyOpenPeekView": "never",
    "testing.openTesting": "neverOpen",
    "testing.automaticallyOpenTestResults": "neverOpen"
}
