{
    // ── Editor ──
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.linkedEditing": true,
    "editor.minimap.enabled": false,
    "editor.wordWrap": "on",
    "editor.suggestSelection": "first",
    "editor.inlineSuggest.enabled": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.fixAll.stylelint": "explicit",
        "source.organizeImports": "never"
    },
    // ── TypeScript ──
    "typescript.tsdk": "../node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    // ── ESLint ──
    "eslint.validate": ["javascript", "typescript"],
    "eslint.run": "onType",
    "eslint.useFlatConfig": true,
    "eslint.lintTask.enable": true,
    // ── Stylelint ──
    "stylelint.validate": ["css"],
    "css.validate": false,
    "less.validate": false,
    "scss.validate": false,
    // ── Baseline Lens — align with .browserslistrc, not full caniuse ──
    // Project supports modern evergreen only (see .browserslistrc). IE/legacy
    // warnings are false positives for our targets.
    // worker/ runs on Cloudflare edge runtime — exclude from browser compat checks.
    "baseline-lens.support": "newly",
    "baseline-lens.browserslist": true,
    "baseline-lens.showInlineHints": false,
    "baseline-lens.exclude": [
        "worker/**",
        "**/worker/**"
    ],
    "baseline-lens.ignoredFeatures": [
        "view-transition-name",
        "@view-transition",
        "scrollbar-width",
        "backdrop-filter",
        "user-select",
        "focus-visible",
        "accent-color",
        "all",
        "min",
        "max",
        "clamp",
        "inset",
        "gap",
        "grid-column",
        "grid-row",
        "margin-block",
        "margin-inline",
        "padding-block",
        "padding-inline",
        "border-block-end",
        "border-block-start",
        "border-inline",
        "outline-offset",
        "has",
        "layer",
        "filter",
        "@property",
        "@scope",
        "@container",
        "light-dark"
    ],

    // ── Files ──
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "*.html": "html"
    },

    // ── HTML ──
    "html.format.wrapLineLength": 120,
    "html.format.indentInnerHtml": true,
    "html.autoClosingTags": true,

    // ── Emmet ──
    "emmet.includeLanguages": {
        "html": "html"
    },

    // ── Git ──
    "git.autofetch": "all",
    "git.autofetchPeriod": 300,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,

    // ── GitHub Copilot ──
    "github.copilot.enable": {
        "*": true,
        "html": true,
        "javascript": true,
        "css": true,
        "markdown": true,
        "yaml": true,
        "json": true
    },
    "chat.agent.enabled": true,
    "chat.useCustomizationsInParentRepositories": true,
    "chat.mcp.autoStart": true,
    "chat.tools.terminal.backgroundNotifications": true,
    "chat.tools.confirmationCarousel.enabled": true,
    "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
    "jsts-chat-features.skills.enabled": true,
    "chat.instructionFilesLocations": {
        ".github/instructions": true,
        ".github/copilot-instructions.md": true
    },
    "chat.promptFilesLocations": {
        ".github/prompts": true
    },
    "chat.skillsFilesLocations": {
        ".github/skills": true
    },

    // ── Spell Check ──
    "cSpell.words": [
        "rajwan",
        "glassmorphism",
        "hebcal",
        "meteo",
        "rotter",
        "giphy",
        "INTC",
        "NVDA",
        "PLTR",
        "familydashboard"
    ],

    // ── Search ──
    "search.exclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/dist": true,
        "**/coverage": true,
        "**/test-results": true
    },

    // ── Markdownlint — exclude auto-generated Playwright artefacts ──
    "markdownlint.ignore": ["test-results/**", "dist/**", "coverage/**", "**/node_modules/**"],

    // ── Terminal Performance ──
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.smoothScrolling": false,
    "terminal.integrated.persistentSessionScrollback": 500,
    "terminal.integrated.scrollback": 5000,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",
    "terminal.integrated.shellIntegration.history": 100,
    "terminal.integrated.enableImages": false,
    "terminal.integrated.defaultProfile.windows": "PowerShell Fast",
    "terminal.integrated.profiles.windows": {
        "PowerShell Fast": {
            "source": "PowerShell",
            "args": ["-NoLogo", "-ExecutionPolicy", "Bypass"],
            "icon": "terminal-powershell"
        },
        "PowerShell NoProfile": {
            "source": "PowerShell",
            "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass"],
            "icon": "terminal-powershell"
        }
    },

    // ── Testing — use terminal only, not VS Code test explorer ──
    "nodejs-testing.enable": false,
    "vitest.enable": false,
    "testing.automaticallyOpenPeekView": "never",
    "testing.openTesting": "neverOpen",
    "testing.automaticallyOpenTestResults": "neverOpen",
    // ── TODO Tree — roadmap & task tracking ──
    "todo-tree.general.enableFileWatcher": true,
    "todo-tree.general.showActivityBarBadge": true,
    "todo-tree.general.tags": [
        "TODO",
        "FIXME",
        "HACK",
        "BUG",
        "PERF",
        "SECURITY",
        "ROADMAP",
        "DEBT",
        "DEPRECATED",
        "BREAKING"
    ],
    "todo-tree.highlights.customHighlight": {
        "TODO": {
            "icon": "checklist",
            "foreground": "#FFD700",
            "type": "tag"
        },
        "FIXME": {
            "icon": "alert",
            "foreground": "#FF6B6B",
            "type": "tag"
        },
        "HACK": {
            "icon": "tools",
            "foreground": "#FF8C00",
            "type": "tag"
        },
        "BUG": {
            "icon": "bug",
            "foreground": "#FF4444",
            "type": "tag"
        },
        "PERF": {
            "icon": "flame",
            "foreground": "#00CED1",
            "type": "tag"
        },
        "SECURITY": {
            "icon": "shield",
            "foreground": "#FF69B4",
            "type": "tag"
        },
        "ROADMAP": {
            "icon": "milestone",
            "foreground": "#7B68EE",
            "type": "tag"
        },
        "DEBT": {
            "icon": "credit-card",
            "foreground": "#FFA500",
            "type": "tag"
        },
        "DEPRECATED": {
            "icon": "trash",
            "foreground": "#808080",
            "type": "tag"
        },
        "BREAKING": {
            "icon": "warning",
            "foreground": "#FF0000",
            "type": "tag"
        }
    },
    "todo-tree.filtering.excludeGlobs": [
        "**/node_modules/**",
        "**/dist/**",
        "**/coverage/**",
        "**/test-results/**",
        "**/.git/**",
        "CHANGELOG.md"
    ],
    "todo-tree.tree.groupedByTag": true,
    "todo-tree.tree.showCountsInTree": true,
    // ── File Nesting — cleaner Explorer ──
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "package.json": "package-lock.json, .npmrc, .nvmrc, .node-version, .browserslistrc, commitlint.config.*, .editorconfig, .prettierrc*, .prettierignore, .eslintcache, CITATION.cff",
        "tsconfig.json": "tsconfig.*.json",
        "vite.config.ts": "vitest.config.ts, vitest.browser.config.ts, playwright.config.ts",
        "README.md": "LICENSE, CHANGELOG.md, CODE_OF_CONDUCT.md, CONTRIBUTING.md",
        "sw.ts": "sw.js"
    },
    // ── Output / generated files → $TEMP enforcement ──
    "files.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/coverage": true,
        "**/test-results": true,
        "**/playwright-report": true,
        "**/blob-report": true,
        "**/.playwright": true,
        "**/.eslintcache": true,
        "**/tsconfig.tsbuildinfo": true
    },
    // ── Workspace Trust ──
    "security.workspace.trust.untrustedFiles": "open",
    // ── Performance ──
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/coverage/**": true,
        "**/test-results/**": true,
        "**/.git/objects/**": true
    }
}
