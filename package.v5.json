{
    "name": "familydashboard",
    "version": "5.2.0-rc.1",
    "description": "Family TV Dashboard — Hebrew RTL, zero dependencies",
    "type": "module",
    "private": true,
    "scripts": {
        "test": "node --test tests/dashboard.test.mjs",
        "test:watch": "node --test --watch tests/dashboard.test.mjs",
        "lint:js": "eslint --config eslint.config.mjs --max-warnings 0 .extracted.js sw.js tests/dashboard.test.mjs",
        "lint:css": "stylelint --config .stylelintrc.json --max-warnings 0 .extracted.css",
        "lint:html": "htmlhint --config .htmlhintrc BestDashBoard.html",
        "lint:md": "markdownlint-cli *.md",
        "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:md"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
